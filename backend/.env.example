APP_NAME=Agentalize Demo API
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Use "auto" to choose MongoDB when MONGODB_URI is set, otherwise in-memory storage.
STORAGE_BACKEND=auto
MONGODB_URI=
MONGODB_DATABASE=agentalize_demo

# Demo authentication. Change these values locally.
SDK_API_KEY=demo-sdk-key
DEMO_ORGANIZATION_ID=org_demo
DEMO_PROJECT_ID=project_demo

FRONTEND_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Runs background investigation jobs inside the API process for the simplest demo.
RUN_WORKER_INLINE=true
WORKER_POLL_SECONDS=1.0

# Local repository inspected by the demo investigator. Writes are disabled by default.
DEMO_REPOSITORY_PATH=../agentalize-sdk
ALLOW_REPOSITORY_WRITES=false
MAX_REPOSITORY_FILES=300
MAX_REPOSITORY_FILE_BYTES=200000

# Optional OpenAI-compatible provider. Without this, deterministic demo analysis is used.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=

ATLAS_VECTOR_SEARCH_ENABLED=false
ATLAS_VECTOR_INDEX=memory_vector_index
